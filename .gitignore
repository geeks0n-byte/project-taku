# Godot 4+ editor cache / imports — never commit these
.godot/
.import/
*.import
export.cfg
export_presets.cfg

# Local CI Godot download cache
.godot-ci/

# Optional machine-local Godot path override
tools/godot.local.env

# Build / platform
/build/
/android/
/ios/
.mono/
bin/
!addons/play_review/bin/
!addons/play_review/bin/**
obj/

# Python
__pycache__/
*.py[cod]
*$py.class

# Editor / OS junk
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.lnk
*.tmp
*~
*.bak

# IDE
.vscode/
.vs/
.idea/
.cursor/

# Godot C# / Mono leftovers
*.csproj.user
*.userprefs
*.mono

# Android signing — never commit
*.keystore
*.jks
*.p12

# Local scratch / review pads (source of truth is translations.csv)
resources/localization/english_copy_review.txt

# Play Games import — Godot CSV sidecars and release zips (regenerate from source CSVs)
resources/play_games/achievement_import/*.translation
resources/play_games/achievement_import/*.zip
